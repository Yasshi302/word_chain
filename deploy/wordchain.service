[Unit]
Description=Word Chain online server
After=network.target game-lobby.service

[Service]
Type=simple
User=wordchain
WorkingDirectory=/opt/wordchain/app/server
Environment=PORT=3003
Environment=LOBBY_INTERNAL=http://127.0.0.1:3100
Environment=WORDCHAIN_DATA=/opt/wordchain/data
ExecStart=/usr/bin/node /opt/wordchain/app/server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
